{
  "manifest_version": 3,
  "name": "Profesia Auto Apply",
  "version": "2.2.0",
  "description": "Auto apply on profesia.sk from the current tab to the right.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["https://*.profesia.sk/*", "https://profesia.sk/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Profesia Auto Apply",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.profesia.sk/*", "https://profesia.sk/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
